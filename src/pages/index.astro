        <div class="field"><label>会社名</label><input type="text" id="f_company" placeholder="株式会社〇〇"></div>
        <div class="field"><label>メールアドレス</label><input type="email" id="f_email" placeholder="you@example.com" required></div>
        <div class="field"><label>お問い合わせ内容</label><textarea rows="4" id="f_message" placeholder="ご相談内容をご記入ください" required></textarea></div>
        <a id="sendLink" class="btn btn-primary" href="mailto:ashrise.office@gmail.com" style="width:100%;justify-content:center;text-decoration:none;">送信する(メールを開く) →</a>
      </form>
      <script is:inline>
        function updateMailLink(){
          var name = document.getElementById('f_name').value;
          var company = document.getElementById('f_company').value;
          var email = document.getElementById('f_email').value;
          var message = document.getElementById('f_message').value;
          var subject = encodeURIComponent('【Ash Rise】サイトからお問い合わせ');
          var body = encodeURIComponent(
            'お名前: ' + name + '\n' +
            '会社名: ' + company + '\n' +
            'メールアドレス: ' + email + '\n\n' +
            'お問い合わせ内容:\n' + message
          );
          document.getElementById('sendLink').href = 'mailto:ashrise.office@gmail.com?subject=' + subject + '&body=' + body;
        }
        ['f_name','f_company','f_email','f_message'].forEach(function(id){
          document.getElementById(id).addEventListener('input', updateMailLink);
        });
        updateMailLink();
      </script>
    </div>
