---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="about">
    <div class="glow"></div>
    <div class="embers">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <h1 class="fade-in">会社概要</h1>
    <div class="content fade-in-delay">
      <p>Ash Riseは、不死鳥が灰から蘇る伝説に由来する社名です。</p>
      <p>私たちは、何度倒れても立ち上がる強さを大切にしています。</p>
    </div>
  </main>
</Layout>

<style>
  .about {
    position: relative;
    min-height: 100vh;
    background-color: #0a0a0a;
    color: #f5f0e8;
    padding: 4rem 2rem;
    max-width: 800px;
    margin: 0 auto;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(255,107,53,0.12), transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
    animation: pulse 6s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.8; }
    50% { transform: translateX(-50%) scale(1.15); opacity: 1; }
  }
  .embers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .embers span {
    position: absolute;
    bottom: -20px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ff8a3d;
    box-shadow: 0 0 6px 2px rgba(255,138,61,0.6);
    animation: rise linear infinite;
  }
  .embers span:nth-child(1) { left: 15%; animation-duration: 9s; animation-delay: 0s; }
  .embers span:nth-child(2) { left: 35%; animation-duration: 12s; animation-delay: 2s; }
  .embers span:nth-child(3) { left: 55%; animation-duration: 8s; animation-delay: 1s; }
  .embers span:nth-child(4) { left: 75%; animation-duration: 14s; animation-delay: 3s; }
  .embers span:nth-child(5) { left: 90%; animation-duration: 10s; animation-delay: 0.5s; }
  @keyframes rise {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translateY(-50vh) translateX(20px); }
    90% { opacity: 0.6; }
    100% { transform: translateY(-100vh) translateX(-15px); opacity: 0; }
  }
  .about h1 {
    position: relative;
    font-size: clamp(2rem, 5vw, 3rem);
    background: linear-gradient(135deg, #ff6b35, #f7931e, #ffd700);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 2rem;
  }
  .content {
    position: relative;
  }
  .content p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #b8b0a0;
    margin-bottom: 1rem;
  }
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease-out forwards;
  }
  .fade-in-delay {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>