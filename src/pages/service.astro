---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="service">
    <div class="glow"></div>
    <div class="embers">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <h1 class="fade-in">事業内容</h1>
    <p class="lead fade-in-delay">SNS運用代行 × 広告事業 × 営業代行 —— ワンストップ型 総合マーケティング支援</p>

    <div class="service-item fade-in-delay">
      <h2>01 SNS運用代行</h2>
      <p>企業のSNSアカウント運用を代行し、企画・撮影・編集・投稿・分析までを一貫して支援します。</p>
    </div>

    <div class="service-item fade-in-delay">
      <h2>02 広告事業</h2>
      <p>Instagram・TikTokを中心に、企業・店舗・賃貸物件・商品などのPRを企画・制作・配信します。</p>
    </div>

    <div class="service-item fade-in-delay">
      <h2>03 営業代行</h2>
      <p>企業の営業活動を代行し、商談・クロージングを中心とした営業支援を行います。</p>
    </div>
  </main>
</Layout>

<style>
  .service {
    position: relative;
    min-height: 100vh;
    background-color: #0a0a0a;
    color: #f5f0e8;
    padding: 4rem 2rem;
    max-width: 800px;
    margin: 0 auto;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(255,107,53,0.12), transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
    animation: pulse 6s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.8; }
    50% { transform: translateX(-50%) scale(1.15); opacity: 1; }
  }
  .embers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .embers span {
    position: absolute;
    bottom: -20px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ff8a3d;
    box-shadow: 0 0 6px 2px rgba(255,138,61,0.6);
    animation: rise linear infinite;
  }
  .embers span:nth-child(1) { left: 15%; animation-duration: 9s; animation-delay: 0s; }
  .embers span:nth-child(2) { left: 35%; animation-duration: 12s; animation-delay: 2s; }
  .embers span:nth-child(3) { left: 55%; animation-duration: 8s; animation-delay: 1s; }
  .embers span:nth-child(4) { left: 75%; animation-duration: 14s; animation-delay: 3s; }
  .embers span:nth-child(5) { left: 90%; animation-duration: 10s; animation-delay: 0.5s; }
  @keyframes rise {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translateY(-50vh) translateX(20px); }
    90% { opacity: 0.6; }
    100% { transform: translateY(-100vh) translateX(-15px); opacity: 0; }
  }
  .service h1 {
    position: relative;
    font-size: clamp(2rem, 5vw, 3rem);
    background: linear-gradient(135deg, #ff6b35, #f7931e, #ffd700);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 0.5rem;
  }
  .lead {
    position: relative;
    color: #b8b0a0;
    margin-bottom: 3rem;
    font-size: 1.05rem;
  }
  .service-item {
    position: relative;
    border-top: 1px solid #2a2a2a;
    padding: 2rem 0;
  }
  .service-item h2 {
    font-size: 1.4rem;
    color: #ff6b35;
    margin-bottom: 0.75rem;
  }
  .service-item p {
    color: #b8b0a0;
    line-height: 1.8;
  }
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease-out forwards;
  }
  .fade-in-delay {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>
